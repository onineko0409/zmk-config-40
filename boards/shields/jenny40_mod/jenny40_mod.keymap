#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* ROW1: red */
                &kp LCTRL  &kp LGUI  &kp LALT  &none      &kp SPACE  &kp SPACE  &none      &kp DOWN  &kp RIGHT  &kp LEFT  &kp BSPC

                /* ROW2: blue */
                &kp LSHFT  &kp Z     &kp X     &kp C      &kp V      &kp B      &kp N     &mo 1     &kp UP  &kp M    &mo 1

                /* ROW3: yellow */
                &kp TAB    &kp A     &kp S     &kp D      &kp F      &kp G      &kp H      &kp K     &kp L     &kp J     &kp ENTER

                /* ROW4: green */
                &kp ESC    &kp Q     &kp W     &kp E      &kp R      &kp T      &kp Y      &kp I     &kp O     &kp U     &kp P
            >;
        };

        fn_layer {
            bindings = <
                &trans     &trans    &trans    &trans     &trans     &trans     &trans     &trans    &trans    &trans    &trans
                &trans     &trans    &trans    &trans     &trans     &trans     &trans     &kp QUESTION    &trans    &trans    &trans
                &trans     &trans    &trans    &trans     &trans     &trans     &trans     &trans    &trans    &trans    &trans
                &trans     &trans    &trans    &trans     &trans     &trans     &trans     &trans    &trans    &trans    &trans
            >;
        };
    };
};
