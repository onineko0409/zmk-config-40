#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        q_excl: q_excl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        w_at: w_at {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp W>, <&kp AT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        e_hash: e_hash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp E>, <&kp HASH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        r_dollar: r_dollar {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp R>, <&kp DLLR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        t_percent: t_percent {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp T>, <&kp PRCNT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        y_caret: y_caret {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp Y>, <&kp CARET>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_ampersand: u_ampersand {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp U>, <&kp AMPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        i_asterisk: i_asterisk {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp I>, <&kp STAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        o_lparen: o_lparen {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp O>, <&kp LPAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        p_rparen: p_rparen {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp P>, <&kp RPAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bspc_equal: bspc_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        g_lbrace: g_lbrace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp G>, <&kp LBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        h_rbrace: h_rbrace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp H>, <&kp RBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        j_colon: j_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp J>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        k_dquote: k_dquote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp K>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        l_pipe: l_pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp L>, <&kp PIPE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n_lt: n_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N>, <&kp LT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        m_gt: m_gt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp M>, <&kp GT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        fn_question: fn_question {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&kp QUESTION>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* ROW1: red */
                &kp LCTRL &kp LGUI &kp LALT &none &kp SPACE &kp SPACE &none &kp DOWN &kp RIGHT &kp LEFT &bspc_equal

                /* ROW2: blue */
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &n_lt &fn_question &kp UP &m_gt &mo 1

                /* ROW3: yellow */
                &kp TAB &kp A &kp S &kp D &kp F &g_lbrace &h_rbrace &k_dquote &l_pipe &j_colon &kp ENTER

                /* ROW4: green */
                &kp ESC &q_excl &w_at &e_hash &r_dollar &t_percent &y_caret &i_asterisk &o_lparen &u_ampersand &p_rparen
            >;
        };

        fn_layer {
            bindings = <
                /* ROW1: red */
                &out OUT_BLE  &out OUT_USB  &trans        &trans        &mkp LCLK     &mkp RCLK     &out OUT_USB  &msc SCRL_DOWN &msc SCRL_RIGHT &msc SCRL_LEFT &kp PLUS

                /* ROW2: blue */
                &trans        &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &mkp MCLK     &bt BT_SEL 2  &kp COMMA     &kp QUESTION   &msc SCRL_UP    &kp DOT        &trans

                /* ROW3: yellow */
                &trans        &ext_power EP_OFF &ext_power EP_ON &ext_power EP_TOG &trans &kp LBKT &kp RBKT &kp SQT &kp BSLH &kp SEMI &trans

                /* ROW4: green */
                &trans        &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6        &kp N8        &kp N9        &kp N7        &kp N0
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        bootloader_combo {
            timeout-ms = <80>;
            key-positions = <33 43>;
            bindings = <&bootloader>;
        };

        ext_power_on_combo {
            timeout-ms = <80>;
            key-positions = <33 34>;
            bindings = <&ext_power EP_ON>;
        };
    };
};
